# Copy this file to .env and fill in real values. Never commit .env.

# Aiven PostgreSQL connection string, with sslmode=require
DATABASE_URL=
# Aiven CA certificate (PEM). Paste the whole certificate; use \n for line breaks if your host needs a single line.
DATABASE_CA_CERT=

# Cloudinary: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# Folder that keeps this project's images separate from other projects
CLOUDINARY_FOLDER=portfolio-gull

# The single admin. Create the hash with: npm run hash-password
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# 32+ random characters, used to sign the session cookie
SESSION_SECRET=

# Vercel on-demand revalidation token (step 5). Leave empty locally. A saved project refreshes Home and its project page when this is set.
REVALIDATE_TOKEN=

# The public address of the site, with https:// and no trailing slash (for canonical links, share previews, sitemap.xml and robots.txt).
# It is baked into the About page at BUILD time, so set it in Vercel before building. Leave empty locally.
NUXT_PUBLIC_SITE_URL=
